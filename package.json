    "server:dev": "node --env-file=.env server/production-index.js",
    "server:start": "node server/production-index.js",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "mysql:start": "node --env-file=.env server/mysql-index.js",
    "mysql:check": "node --env-file=.env server/check-mysql.js",
    "test": "node --test"
  },
  "dependencies": {
