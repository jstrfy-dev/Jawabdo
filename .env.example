# Expo client does not read server credentials. These values are server-only.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jawabdo
MYSQL_USER=root
MYSQL_PASSWORD=

# XAMPP usually uses root with an empty local password; set MYSQL_PASSWORD when yours differs.
# PostgreSQL 15+ recommended. Use a TLS URL from your managed database.
DATABASE_URL=postgresql://jawabdo:replace-me@localhost:5432/jawabdo
DATABASE_SSL=false

# Generate independently with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://your-public-https-domain.example
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional frontend-only API origin. Leave blank to use the Expo host network address
# on Android and localhost on web/iOS. On a physical device, Expo's LAN host must
# be the computer running the backend, or set this to that computer's LAN origin.
EXPO_PUBLIC_API_URL=

# Meta app details. Create a Facebook Login for Business Embedded Signup v4 config.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# Required only by the isolated, single-number test server (`npm run whatsapp:dev`).
# These values are not used by the multi-tenant production backend.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_AUTO_REPLY_TEXT=Test message received by JawabDo.

# Optional. Without this, the AI assistant stays disabled and hands off to the owner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional approved WhatsApp template names. Reminder variables, in order:
# customer name, service name, appointment date/time, business name.
WHATSAPP_CUSTOMER_REMINDER_TEMPLATE=
WHATSAPP_OWNER_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
